# Store text files with LF line endings in the repository; Git decides which files are text.
* text=auto

# Visual Studio solution, project and resource files are checked out with Windows (CRLF) line
# endings on every machine, whatever core.autocrlf says, so Visual Studio never rewrites them.
*.sln              text eol=crlf
*.vcxproj          text eol=crlf
*.vcxproj.filters  text eol=crlf
*.rc               text eol=crlf

# Source and documentation: text, line endings follow the checkout platform.
*.cpp  text diff=cpp
*.h    text diff=cpp
*.md   text
*.yml  text

# Binary files: never convert or diff as text.
*.ico  binary
